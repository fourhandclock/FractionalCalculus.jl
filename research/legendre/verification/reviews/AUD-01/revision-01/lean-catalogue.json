      "lean_statement": "theorem quadratic_history_collection (c v : ℕ → ℝ) (N : ℕ) :\n    (∑ n ∈ Finset.range N,\n      ∑ j ∈ Finset.range (n + 1), c (n - j) * (v (j + 1) - v j)) =\n      (∑ j ∈ Finset.range N, c (N - 1 - j) * v (j + 1)) -\n        (∑ r ∈ Finset.range N, c r) * v 0",
